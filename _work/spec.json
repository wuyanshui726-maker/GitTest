        { "from": "l2", "to": "l1", "text": "修改订单价格", "kind": "sync" },
        { "from": "l1", "to": "l0", "text": "返回改价后的订单金额", "kind": "return" },
        { "from": "l0", "to": "l1", "text": "使用优惠券并确认收货地址", "kind": "sync" },
        { "from": "l1", "to": "l1", "text": "计算优惠金额与运费", "kind": "self" },
        { "from": "l0", "to": "l1", "text": "选择支付方式并支付()", "kind": "sync" },
        { "from": "l1", "to": "l3", "text": "发起支付请求(金额)", "kind": "sync" },
        { "from": "l3", "to": "l1", "text": "支付成功回调(交易号)", "kind": "return" },
        { "from": "l1", "to": "l0", "text": "支付成功，订单已确认", "kind": "return" },
        { "from": "l1", "to": "l2", "text": "通知发货", "kind": "sync" },
        { "from": "l2", "to": "l1", "text": "确认订单并发货(物流单号)", "kind": "sync" },
        { "from": "l1", "to": "l0", "text": "发货通知与物流信息", "kind": "return" }
      ]
    },
    {
      "diagram": "发布商品顺序图",
      "lifelines": [
        { "id": "l0", "name": "卖家", "x": 220 },
        { "id": "l1", "name": "卖家中心(平台)", "x": 650 },
        { "id": "l2", "name": "商品管理服务", "x": 1120 },
        { "id": "l3", "name": "图片存储服务", "x": 1510 }
      ],
      "messages": [
        { "from": "l0", "to": "l1", "text": "登录并进入卖家中心", "kind": "sync" },
        { "from": "l1", "to": "l2", "text": "校验卖家身份与店铺权限", "kind": "sync" },
        { "from": "l2", "to": "l1", "text": "返回店铺列表", "kind": "return" },
        { "from": "l1", "to": "l0", "text": "显示店铺与商品类别", "kind": "return" },
        { "from": "l0", "to": "l1", "text": "选择店铺与商品类别", "kind": "sync" },
        { "from": "l1", "to": "l2", "text": "获取类别属性模板", "kind": "sync" },
        { "from": "l2", "to": "l1", "text": "返回属性模板(名称、类型、必填项)", "kind": "return" },
        { "from": "l0", "to": "l1", "text": "填写商品信息(名称、价格、库存等)", "kind": "sync" },
        { "from": "l0", "to": "l1", "text": "上传商品图片(可多张)", "kind": "sync" },
        { "from": "l1", "to": "l3", "text": "保存图片文件", "kind": "sync" },
        { "from": "l3", "to": "l1", "text": "返回图片URL列表", "kind": "return" },
        { "from": "l0", "to": "l1", "text": "设置自定义属性(功率、材质等)", "kind": "sync" },
        { "from": "l1", "to": "l2", "text": "校验属性并保存商品", "kind": "sync" },
        { "from": "l2", "to": "l1", "text": "返回商品编号", "kind": "return" },
        { "from": "l0", "to": "l1", "text": "设置上架时间并提交上架", "kind": "sync" },
        { "from": "l1", "to": "l2", "text": "更新商品状态为上架", "kind": "sync" },
        { "from": "l2", "to": "l1", "text": "返回上架成功", "kind": "return" },
        { "from": "l1", "to": "l0", "text": "商品发布成功", "kind": "return" }
      ]
    },
    {
      "diagram": "卖家入驻与开店顺序图",
      "lifelines": [
        { "id": "l0", "name": "卖家", "x": 220 },
        { "id": "l1", "name": "电子商务平台", "x": 700 },
        { "id": "l2", "name": "认证服务", "x": 1180 },
        { "id": "l3", "name": "平台管理员", "x": 1560 }
      ],
      "messages": [
        { "from": "l0", "to": "l1", "text": "提交入驻申请(资质材料)", "kind": "sync" },
        { "from": "l1", "to": "l2", "text": "校验营业执照与实名信息", "kind": "sync" },
        { "from": "l2", "to": "l1", "text": "返回校验结果", "kind": "return" },
        { "from": "l1", "to": "l3", "text": "生成待审核任务", "kind": "sync" },
        { "from": "l3", "to": "l1", "text": "查看资质材料并审核", "kind": "sync" },
        { "from": "l3", "to": "l1", "text": "审核通过，分配卖家账号", "kind": "sync" },
        { "from": "l1", "to": "l0", "text": "通知入驻成功", "kind": "return" },
        { "from": "l0", "to": "l1", "text": "开店(店铺名称、经营模式)", "kind": "sync" },
        { "from": "l1", "to": "l1", "text": "创建店铺并绑定卖家账号", "kind": "self" },
        { "from": "l1", "to": "l0", "text": "返回店铺创建成功", "kind": "return" },
        { "from": "l0", "to": "l1", "text": "选择经营模式(自营 / 推广)", "kind": "sync" },
        { "from": "l1", "to": "l0", "text": "入驻完成，可发布商品", "kind": "return" }
      ]
    }
