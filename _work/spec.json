        { "id": "product", "name": "商品 Product", "x": 550, "y": 510, "w": 400,
          "attrs": ["商品编号: String", "商品名称: String", "价格: Decimal", "库存数量: int", "是否上架: Boolean", "是否可租赁: Boolean"],
          "ops": ["上架()", "计算实付价()"] },
        { "id": "shop", "name": "店铺 Shop", "x": 1040, "y": 575, "w": 350,
          "attrs": ["店铺编号: String", "店铺名称: String", "经营模式: 枚举", "店铺状态: String"],
          "ops": ["管理商品()"] },
        { "id": "image", "name": "商品图片 ProductImage", "x": 550, "y": 880, "w": 360,
          "attrs": ["图片编号: String", "图片URL: String", "排序号: int", "是否主图: Boolean"] },
        { "id": "supplier", "name": "供应商 Supplier", "x": 1040, "y": 880, "w": 350,
          "attrs": ["供应商编号: String", "供应商名称: String", "联系方式: String", "结算方式: String"] }
      ],
      "rels": [
        { "type": "gen", "from": "buyer", "to": "user" },
        { "type": "gen", "from": "seller", "to": "user" },
        { "type": "assoc", "from": "seller", "to": "shop", "m1": "1", "m2": "0..*" },
        { "type": "comp", "from": "shop", "to": "product", "m1": "1", "m2": "*" },
        { "type": "assoc", "from": "category", "to": "product", "m1": "1", "m2": "*" },
        { "type": "comp", "from": "product", "to": "image", "m1": "1", "m2": "*" },
        { "type": "assoc", "from": "shop", "to": "supplier", "m1": "0..*", "m2": "0..1" }
      ]
    },
    {
      "diagram": "类图（二）：商品类型与动态属性",
      "canvas": [1500, 880],
      "items": [
        { "id": "p2", "name": "商品 Product（引用）", "x": 80, "y": 40, "w": 350,
          "attrs": ["商品编号: String", "商品名称: String", "基准价格: Decimal"] },
        { "id": "c2", "name": "商品类别 Category（引用）", "x": 520, "y": 40, "w": 330,
          "attrs": ["类别编号: String", "类别名称: String"] },
        { "id": "attrdef", "name": "属性定义 AttributeDef", "x": 980, "y": 40, "w": 360,
          "attrs": ["属性编号: String", "属性名称: String", "数据类型: String", "是否必填: Boolean"],
          "ops": ["校验值()"] },
        { "id": "attrval", "name": "商品属性值 ProductAttrValue", "x": 980, "y": 330, "w": 360,
          "attrs": ["属性值编号: String", "属性值: String", "计量单位: String"] },
        { "id": "physical", "name": "实物商品 PhysicalProduct", "x": 120, "y": 300, "w": 350,
          "attrs": ["包装规格: String", "是否需配套: Boolean"] },
        { "id": "virtual", "name": "虚拟商品 VirtualProduct", "x": 120, "y": 720, "w": 350,
          "attrs": ["卡密/下载链接: String", "有效天数: int"] },
        { "id": "single", "name": "单件商品 SingleItem", "x": 560, "y": 300, "w": 280,
          "attrs": ["单件规格: String"] },
        { "id": "multi", "name": "多件商品 MultiItem", "x": 560, "y": 455, "w": 280,
          "attrs": ["组合件数: int", "单件规格: String"] },
        { "id": "bundle", "name": "套装商品 BundleItem", "x": 560, "y": 615, "w": 280,
          "attrs": ["套装件数: int", "套装清单: String"] }
      ],
      "rels": [
        { "type": "gen", "from": "physical", "to": "p2" },
        { "type": "gen", "from": "virtual", "to": "p2" },
        { "type": "gen", "from": "single", "to": "physical" },
        { "type": "gen", "from": "multi", "to": "physical" },
        { "type": "gen", "from": "bundle", "to": "physical" },
        { "type": "comp", "from": "p2", "to": "attrval", "m1": "1", "m2": "*" },
        { "type": "assoc", "from": "attrdef", "to": "attrval", "m1": "1", "m2": "*" },
        { "type": "assoc", "from": "c2", "to": "attrdef", "m1": "1", "m2": "*" },
        { "type": "assoc", "from": "c2", "to": "p2", "m1": "1", "m2": "*" }
      ]
    },
    {
      "diagram": "类图（三）：购物车、订单与营销",
