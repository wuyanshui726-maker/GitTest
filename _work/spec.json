        { "id": "order", "name": "订单 Order", "x": 500, "y": 40, "w": 400,
          "attrs": ["订单编号: String", "下单时间: Date", "订单状态: 枚举", "商品总额: Decimal", "优惠金额: Decimal", "实付金额: Decimal", "支付方式: String"],
          "ops": ["生成订单()", "确认收货()"] },
        { "id": "orderitem", "name": "订单项 OrderItem", "x": 500, "y": 480, "w": 340,
          "attrs": ["订单项编号: String", "数量: int", "成交单价: Decimal", "小计: Decimal"] },
        { "id": "returnreq", "name": "退货申请 ReturnRequest", "x": 960, "y": 620, "w": 360,
          "attrs": ["申请编号: String", "退货原因: String", "申请时间: Date", "审核状态: 枚举", "退款金额: Decimal"],
          "ops": ["审核()"] },
        { "id": "coupon", "name": "优惠券 Coupon", "x": 960, "y": 40, "w": 360,
          "attrs": ["券编号: String", "券类型: 枚举", "面额: Decimal", "折扣率: Decimal", "使用门槛: Decimal", "生效时间: Date", "失效时间: Date", "状态: 枚举"] },
        { "id": "promotion", "name": "促销活动 Promotion", "x": 960, "y": 360, "w": 360,
          "attrs": ["活动编号: String", "活动类型: 枚举", "折扣率: Decimal", "开始时间: Date", "结束时间: Date"] },
        { "id": "product3", "name": "商品 Product（引用）", "x": 500, "y": 860, "w": 350,
          "attrs": ["商品编号: String", "商品名称: String", "价格: Decimal"] }
      ],
      "rels": [
        { "type": "comp", "from": "buyer3", "to": "cart", "m1": "1", "m2": "1" },
