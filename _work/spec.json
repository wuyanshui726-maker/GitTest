      "rels": [
        { "type": "assoc", "from": "buyer4", "to": "comp", "m1": "1", "m2": "*" },
        { "type": "assoc", "from": "comp", "to": "compitem", "m1": "1", "m2": "1..5" },
        { "type": "assoc", "from": "compitem", "to": "product4", "m1": "*", "m2": "1" }
      ]
