    {
      "diagram": "类图（四）：商品比价",
      "canvas": [1320, 620],
      "items": [
        { "id": "buyer4", "name": "买家 Buyer（引用）", "x": 60, "y": 60, "w": 320,
          "attrs": ["买家编号: String", "买家等级: int", "积分: int"] },
        { "id": "comp", "name": "比价单 Comparison", "x": 60, "y": 290, "w": 350,
          "attrs": ["比价单编号: String", "创建时间: Date", "比较维度: String"],
          "ops": ["添加商品()"] },
        { "id": "compitem", "name": "比价项 ComparisonItem", "x": 540, "y": 290, "w": 350,
          "attrs": ["比价项编号: String", "快照价格: Decimal", "快照时间: Date"] },
        { "id": "product4", "name": "商品 Product（引用）", "x": 1000, "y": 300, "w": 300,
          "attrs": ["商品编号: String", "商品名称: String"] }
