        { "from": "l0", "to": "l1", "text": "加入购物车()", "kind": "sync" },
        { "from": "l0", "to": "l1", "text": "提交订单(商品、数量)", "kind": "sync" },
        { "from": "l1", "to": "l2", "text": "推送订单(待卖家确认)", "kind": "sync" },
        { "from": "l0", "to": "l1", "text": "请求联系店家改价", "kind": "sync" },
