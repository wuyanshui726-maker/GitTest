        { "id": "buyer3", "name": "买家 Buyer（引用）", "x": 60, "y": 40, "w": 320,
          "attrs": ["买家编号: String", "买家等级: int", "积分: int"] },
        { "id": "cart", "name": "购物车 Cart", "x": 60, "y": 280, "w": 340,
