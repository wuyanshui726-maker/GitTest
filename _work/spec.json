  "classes": [
    {
      "diagram": "类图（一）：用户、店铺与商品",
      "canvas": [1500, 1120],
      "items": [
        { "id": "user", "name": "用户 User", "x": 560, "y": 30, "w": 360,
          "attrs": ["用户编号: String", "用户名: String", "手机号: String", "用户类型: 枚举"] },
        { "id": "buyer", "name": "买家 Buyer", "x": 110, "y": 270, "w": 350,
